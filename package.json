{
  "name": "playwright-mcp-extension",
  "version": "1.3.0",
  "description": "Multi-Agent Physical Window Isolation for Playwright MCP in Chrome",
  "main": "src/index.js",
  "bin": {
    "playwright-mcp-extension": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "postinstall": "node src/patcher.js",
    "setup": "node scripts/setup.js",
    "test": "node test/test_multiplexer.js",
    "build:extension": "npm --prefix extension run build",
    "setup:global": "npm link"
  },
  "dependencies": {
    "@playwright/mcp": "^0.0.86",
    "ws": "^8.18.0"
  },
  "keywords": [
    "playwright",
    "mcp",
    "multi-agent",
    "chrome-extension",
    "window-isolation",
    "antigravity",
    "ai-agents"
  ],
  "author": "",
  "license": "Apache-2.0"
}
